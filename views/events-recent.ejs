<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Recent Events | MLSA DYPCET</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Tailwind (prefixed) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      prefix: 'tw-',
      corePlugins: { preflight: false },
      theme: {
        extend: {
          colors: {
            brand: '#00ff88',
            accent: '#00e5ff',
            purple: '#a855f7'
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0a0f1c;
    }
    .neon-card {
      background: rgba(14, 21, 48, 0.7);
      border: 1px solid rgba(0, 229, 255, 0.25);
      box-shadow: 0 0 20px rgba(0,255,136,0.15);
    }
  </style>
</head>

<body class="text-white">

<!-- PAGE HEADER -->
<div class="container py-5">
  <h2 class="text-center mb-2 tw-font-orbitron tw-text-3xl">
    <i class="fa-solid fa-clock-rotate-left tw-text-brand"></i> Recent Events
  </h2>
  <p class="text-center tw-text-gray-400 mb-5">
    A look back at what we’ve built and learned together
  </p>

  <% if (recentEvents.length > 0) { %>

  <!-- EVENTS GRID -->
  <div class="row g-4 justify-content-center">

    <% recentEvents.forEach(event => { %>

      <div class="col-md-6 col-lg-4 d-flex">

        <div class="neon-card tw-rounded-2xl tw-overflow-hidden tw-w-full tw-transition-all hover:tw-scale-[1.02]">

          <!-- Image -->
          <div class="tw-relative">
            <% if (event.image_url) { %>
              <img 
  src="<%= event.image_url %>" 
  alt="<%= event.title %>"
  class="tw-w-full tw-max-h-60 tw-object-contain tw-rounded-t-2xl"
/>

            <% } else { %>
              <div class="tw-h-48 tw-bg-gradient-to-br tw-from-accent/20 tw-to-purple/20"></div>
            <% } %>

            <!-- Date Badge -->
            <span class="tw-absolute tw-top-3 tw-left-3 tw-bg-black/70 tw-text-brand tw-text-xs tw-px-3 tw-py-1 tw-rounded-full">
              <%= new Date(event.date).toDateString() %>
            </span>
          </div>

          <!-- Content -->
          <div class="tw-p-4">
            <h5 class="tw-text-white tw-font-semibold tw-text-lg">
              <%= event.title %>
            </h5>

            <p class="tw-text-[var(--muted)] tw-text-sm tw-mt-1 tw-line-clamp-2">
  <%= event.description %>
</p>

            <div class="tw-text-xs tw-text-gray-400 tw-flex tw-gap-4 tw-mt-3">
              <span>
                <i class="fa-solid fa-location-dot tw-text-accent"></i>
                <%= event.venue %>
              </span>
              <span>
                <i class="fa-solid fa-users tw-text-purple"></i>
                <%= event.mode %>
              </span>
            </div>
            <a href="/events/recent/<%= event.id %>" class="btn btn-outline-info btn-sm tw-rounded-full tw-mt-4">
  View Details →
</a>


          </div>

        </div>

      </div>

    <% }) %>

  </div>

  <% } else { %>

    <p class="text-center tw-text-gray-400">
      No recent events available.
    </p>

  <% } %>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
