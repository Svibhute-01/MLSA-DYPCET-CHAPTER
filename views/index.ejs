      <div class="row gy-4">
        <div class="col-lg-6">
          <div class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
            <span class="tw-inline-flex tw-items-center tw-justify-center tw-w-9 tw-h-9 tw-rounded-lg tw-bg-[rgba(0,229,255,0.12)] tw-border tw-border-[rgba(0,229,255,0.25)] tw-text-accent">M</span>
